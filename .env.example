DISCORD_BOT_TOKEN=

# Read chat aloud (/tts). Optional; defaults shown.
# Enabling this requests the privileged Message Content intent, which must be
# switched on for the bot in the Discord Developer Portal first.
TTS_ENABLED=false
GOOGLE_TTS_API_KEY=
# Gemini-TTS needs a service account JSON key file instead of an API key:
GOOGLE_APPLICATION_CREDENTIALS=
TTS_LANG=th
# With a Gemini model, TTS_VOICE is the bare fallback speaker name (default Charon).
TTS_VOICE=
# Optional comma-separated pool of per-participant session voices (defaults to
# the 16 Gemini-TTS male voices; bare names map to <lang>-Chirp3-HD-<Name> when
# TTS_MODEL is empty):
TTS_VOICE_POOL=
# Gemini-TTS: set TTS_MODEL (e.g. gemini-2.5-flash-tts) to switch from
# Chirp/Neural2; TTS_PROMPT is an optional style prompt (Gemini only).
TTS_MODEL=
TTS_PROMPT=
# Gemini only: stream audio over gRPC and start speaking at the first chunk.
# Defaults to true with a Gemini TTS_MODEL; needs GOOGLE_APPLICATION_CREDENTIALS.
TTS_STREAMING=
TTS_MAX_CHARS=200
TTS_QUEUE_SIZE=20
TTS_SPEAK_AUTHOR=true

# Google TTS usage cap. Chirp/Neural2 (no TTS_MODEL): characters sent per
# US/Pacific month; 0 = no cap.
TTS_MONTHLY_CHAR_LIMIT=1000000
# Gemini (TTS_MODEL set): money cap in baht per US/Pacific month, and the
# USD->THB rate used to price requests. 0 budget = no cap.
TTS_MONTHLY_BUDGET_THB=300
TTS_USD_TO_THB=33
# Channel for usage alerts (50/80/100%) and the persisted counter. Needs View
# Channel, Send Messages and Read Message History. If empty, the count is kept
# in memory and resets on restart.
# Delete each participant message this long after it was read (0 = only at session end).
TTS_DELETE_AFTER=8s
TTS_ALERT_CHANNEL_ID=

# Server events (/event). Always on; defaults shown.
# Reminder channel; empty falls back to TTS_ALERT_CHANNEL_ID (no channel = no reminders).
EVENT_CHANNEL_ID=
# How long before the start to mention the interested users (0 = off).
EVENT_REMIND_BEFORE=15m
# Also start/end events made by people in Discord (the bot's own are always handled).
EVENT_AUTO_START=true
# Optional image libraries, tried before Openverse (which needs no key).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Brave Search image results: ordinary web images WITHOUT a licence, for a
# private server only. Tried after Unsplash, before Openverse. Unset = off.
BRAVE_SEARCH_API_KEY=
# Thai event names are turned into English search words with Gemini on
# Vertex AI using GOOGLE_APPLICATION_CREDENTIALS (above) when it is set.

# HTTP server: dashboard (Discord login), webhooks and GET /healthz.
# Empty or "off" turns the server off.
DASHBOARD_ADDR=:8080
# Dashboard login: set all three, or none (then only /healthz and webhooks work).
# Register <DASHBOARD_PUBLIC_URL>/auth/callback in the Developer Portal → OAuth2 → Redirects.
DASHBOARD_PUBLIC_URL=
DISCORD_CLIENT_SECRET=
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
DASHBOARD_SESSION_KEY=
# Optional: OAuth2 client ID (defaults to the bot's application ID).
DISCORD_CLIENT_ID=
# Optional: user IDs always allowed in, besides server admins/managers.
DASHBOARD_ALLOWED_USERS=
# Webhooks: name=token@channelID, comma-separated (tokens >= 16 chars).
WEBHOOKS=
