DISCORD_BOT_TOKEN=

# Read chat aloud (/tts). Optional; defaults shown.
# Enabling this requests the privileged Message Content intent, which must be
# switched on for the bot in the Discord Developer Portal first.
TTS_ENABLED=false
GOOGLE_TTS_API_KEY=
TTS_LANG=th
TTS_VOICE=
TTS_MAX_CHARS=200
TTS_QUEUE_SIZE=20
TTS_SPEAK_AUTHOR=true

# Google TTS usage cap. Characters sent per US/Pacific month; 0 = no cap.
TTS_MONTHLY_CHAR_LIMIT=1000000
# Channel for usage alerts (50/80/100%) and the persisted counter. Needs View
# Channel, Send Messages and Read Message History. If empty, the count is kept
# in memory and resets on restart.
TTS_ALERT_CHANNEL_ID=
